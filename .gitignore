# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Data caches (regenerable, can be large)
01_data_raw/_cache/

# Raw StatsBomb event parquets (~206 MB, regenerable via
# 06_ingestion/statsbomb_loader.py from free open data; the 86 MB PL file is
# near GitHub's 100 MB per-file hard limit). The derived training tables in
# 02_data_processed/ ARE versioned — re-download raw events only if you need
# event-level granularity.
01_data_raw/events/

# Driver lock artifact
downloaded_files/driver_fixing.lock

# Synthetic / scraped betting artifacts — regenerated by
# 07_features/build_matches_view.py --synthetic, or replaced by live scraped
# odds. fixtures.parquet and match_players.parquet (the real prediction store)
# ARE versioned.
02_data_processed/matches_view/match_odds.parquet
02_data_processed/matches_view/match_value.parquet

# Scraped live odds snapshots — volatile, dated, accumulate one file per run.
# Regenerate with 06_ingestion/pinnacle_scraper.py.
01_data_raw/odds/

# World Cup value boards + dashboard — derived from volatile odds. Regenerate
# with 08_models/worldcup_value.py + 10_serving/build_dashboard.py.
10_serving/worldcup/value_board_*
10_serving/worldcup/dashboard.html

# Match prediction outputs — derived from Betano JSON. Regenerate with
# 08_models/predict_match.py + 10_serving/build_match_dashboard.py.
10_serving/matches/*.html
10_serving/matches/*_pred.md

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
